# Copy to .env and fill in. docker-compose reads this automatically.

# --- Database (defaults are fine for local MVP) ---
DB_NAME=crm
DB_USER=crm
DB_PASSWORD=crm

# --- Auth ---
# Must be a real random secret >= 32 bytes before this goes anywhere near production.
# Generate one with: openssl rand -base64 48
JWT_SECRET=please-generate-a-real-32-byte-secret-change-me
# Vite dev server + the docker-compose nginx frontend — the browser sends an
# Origin header on POST/PATCH even for the same-origin nginx-proxied requests,
# so both must be allowlisted here even though only one applies per how you run it.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- LLM (OpenAI-compatible Chat Completions endpoint) ---
# Defaults to DeepSeek directly. Swapping providers is just changing these three
# vars (e.g. Qwen/DashScope's OpenAI-compatible endpoint, or OpenRouter) — no code change.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- WhatsApp Cloud API ---
# Needs a Meta Business app + a phone number migrated to Cloud API. Until these
# are set, outbound WhatsApp sends log a no-op instead of failing.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Instagram Messaging API ---
# Needs Meta App Review approval for instagram_manage_messages (1-4 weeks) —
# start this early. Until set, outbound Instagram sends log a no-op.
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=

# --- Google Calendar (office visit booking) ---
# Not yet wired up (NoopCalendarService) — needs a Google Cloud project + OAuth
# consent screen. Placeholder vars for when that lands.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
